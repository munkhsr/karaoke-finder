# Cloudflare Pages cache headers. Without them every image and script is
# revalidated on each visit, which multiplies requests per page view.

# Build output with content hashes in the file name never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Artist photos, icons and hero images keep their names when replaced,
# so cache them for a week and refresh in the background afterwards.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
